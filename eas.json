{
    "build": {
        "production": {
            "android": {
                "buildType": "apk",
                "gradleCommand": ":app:assembleRelease",
                "autoIncrement": true,
                "env": {
                    "EXPO_TARGET": "bare"
                },
                "cache": {
                    "enabled": true,
                    "key": "all",
                    "paths": [
                        "node_modules/**/*",
                        ".expo-shared/**/*",
                        ".yarn/**/*"
                    ]
                }
            }
        }
    }
}